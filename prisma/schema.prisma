generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
//  User — stores credentials, device binding, active plan
// ─────────────────────────────────────────────────────────
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  name            String?
  phone           String?
  role            String         @default("USER") // USER or ADMIN
  // ── Device Binding (anti-credential-sharing) ──
  boundDeviceId   String?        // Fingerprint of the first device that logged in
  // ── Subscription ──
  plan            String         @default("FREE") // FREE, BEGINNING, ADVANCED, ENTERPRISE
  beginningExamId String?
  planPurchasedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  subscriptions   Subscription[]
  beginningExam   Exam?          @relation("BeginningPlanExam", fields: [beginningExamId], references: [id])
}

// ─────────────────────────────────────────────────────────
//  Subscription — purchase records bound to user + device
// ─────────────────────────────────────────────────────────
model Subscription {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  beginningExamId String?
  beginningExam Exam?   @relation("BeginningSubscriptionExam", fields: [beginningExamId], references: [id])
  plan        String    // BEGINNING, ADVANCED, ENTERPRISE
  amount      Int       // price in INR (200, 500, 5000)
  currency    String    @default("INR")
  deviceId    String    // device fingerprint at time of purchase
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  purchasedAt DateTime  @default(now())
  expiresAt   DateTime?
}

// ─────────────────────────────────────────────────────────
//  Exam + Question + Session — unchanged from original
// ─────────────────────────────────────────────────────────
model Exam {
  id                String     @id @default(uuid())
  title             String
  certificationCode String?
  provider          String?
  categoryTags      String     @default("[]")
  passingScore      Float      @default(70.0)
  timeLimit         Int?       // in minutes
  status            String     @default("draft") // draft, published
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  questions         Question[]
  sessions          Session[]
  beginningUsers    User[]     @relation("BeginningPlanExam")
  beginningSubscriptions Subscription[] @relation("BeginningSubscriptionExam")
}

model Question {
  id              String   @id @default(uuid())
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id])
  question        String
  options         String
  answer          Int      // Index of correct option
  explanation     String?
  topic           String?
  difficulty      String   @default("medium") // easy, medium, hard
  source          String   @default("ai_parsed") // ai_parsed, manual, csv_import
  status          String   @default("pending_review") // pending_review, published, rejected
  confidenceScore Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  score     Float?
  passed    Boolean?
  startTime DateTime @default(now())
  endTime   DateTime?
  mode      String   @default("practice") // practice, mock, etc.
}

model ModuleRequest {
  id           String   @id @default(uuid())
  name         String
  email        String
  moduleName   String
  provider     String?
  urgency      String   @default("LATER") // ASAP, THIS_MONTH, LATER
  preorderReady Boolean @default(false)
  notes        String?
  status       String   @default("NEW") // NEW, IN_REVIEW, PLANNED, RELEASED, REJECTED
  adminNotes   String?
  requestedAt  DateTime @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([email, moduleName])
}
